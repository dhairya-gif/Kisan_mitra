# ===========================================================================
# Kisan Mitra - Environment Configuration Example Template
# Copy this file to .env and insert your API keys
# ===========================================================================

# --- API Keys ---
# Ministry of Agriculture Agmarknet Resource API (data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Groq High-Speed Inference API Key (Whisper Large v3 & Qwen 3.8-27B)
GROQ_API_KEY=your_groq_api_key_here

# Optional Fallback Keys
OPENAI_API_KEY=
IMD_API_KEY=
IMD_STATION_ID=

# --- Server & Network ---
SERVER_PORT=8501
HOST=0.0.0.0

# --- Resource Identifiers & Models ---
DATA_GOV_IN_MANDI_RESOURCE=9ef84268-d588-465a-a308-a864a43d0070
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3

# --- Application Defaults ---
DEFAULT_DISTRICT=Ludhiana
DEFAULT_CROP=Wheat
CACHE_TTL_MINUTES=20
